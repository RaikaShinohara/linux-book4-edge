/*
 * Recovery variant: retain the firmware framebuffer while diagnosing USB-A.
 * The normal board DTB remains the native-display test target.
 */

#include "x1p42100-samsung-galaxy-book4-edge.dts"

/ {
	model = "Samsung Galaxy Book4 Edge (NP750XQA, firmware display recovery)";
};

&backlight {
	status = "disabled";
};

&mdss_dp3 {
	status = "disabled";
};

&pmk8550_pwm {
	status = "disabled";
};

/* Match the single-port MP0 topology used by the working Samsung 14" DTS. */
&usb_mp_dwc3 {
	phys = <&usb_mp_hsphy0>, <&usb_mp_qmpphy0>;
	phy-names = "usb2-0", "usb3-0";
};

&eusb6_repeater {
	status = "okay";
};

&usb_a_eusb_repeater {
	status = "disabled";
};

&usb_mp_hsphy0 {
	phys = <&eusb6_repeater>;
};

/* x1-crd enables MP1 as well; the known-working Samsung DTS does not. */
&usb_mp_hsphy1 {
	status = "disabled";
};

&usb_mp_qmpphy1 {
	status = "disabled";
};
