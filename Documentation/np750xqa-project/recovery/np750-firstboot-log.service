[Unit]
Description=Capture NP750XQA first-boot diagnostics on external root
Wants=systemd-udev-settle.service
After=local-fs.target systemd-udev-settle.service

[Service]
Type=oneshot
ExecStartPre=/usr/bin/sleep 60
ExecStart=/usr/local/sbin/np750-firstboot-log
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
