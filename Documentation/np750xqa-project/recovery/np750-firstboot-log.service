[Unit]
Description=Capture NP750XQA first-boot diagnostics on external root
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/np750-firstboot-log
RemainAfterExit=yes
TimeoutStartSec=30
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
