#!/usr/bin/ash

run_earlyhook() {
    mkdir -p /run/tmpfiles.d
    if command -v /usr/sbin/systemd-tmpfiles >/dev/null 2>&1; then
        kmod static-nodes --format=tmpfiles --output=/run/tmpfiles.d/kmod.conf
        /usr/sbin/systemd-tmpfiles --prefix=/dev --create --boot
    fi
    if /usr/lib/systemd/systemd-udevd --daemon --resolve-names=never; then
        udevd_running=1
    else
        udevd_running=0
        echo 'NP750XQA: udev daemon failed to start'
    fi
}

run_hook() {
    msg ':: Triggering uevents (NP750XQA bounded diagnostic)...'
    udevadm trigger --action=add --type=subsystems
    udevadm trigger --action=add --type=devices
    udevadm settle --timeout=15 || echo 'NP750XQA: udev settle timed out after 15 seconds'
    echo 'NP750XQA: udev hook finished; continuing toward root discovery'
}

run_cleanuphook() {
    udevadm control --exit
    udevadm info --cleanup-db
}
